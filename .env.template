# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=your_dataset
NEXT_PUBLIC_SANITY_API_VERSION=your_api_version
SANITY_API_TOKEN=your_sanity_api_token
# Optional Viewer token for read-only paths (pages, pricing). Falls back to SANITY_API_TOKEN.
SANITY_READ_TOKEN=
# Shared secret the Sanity webhook sends as x-webhook-secret to /api/revalidate
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Gift Cards (Stripe webhook handles creation, no extra keys needed)

# Resend 
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_from_email
CONTACT_EMAIL_TO=your_contact_email

# Cal.com
NEXT_PUBLIC_CAL_USERNAME=your_cal_username
CAL_API_KEY=your_cal_api_key

# Upstash Redis — per-IP rate limits for the public API routes (lib/rate-limit.ts).
# Leave unset locally to turn rate limiting off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Frontend
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000